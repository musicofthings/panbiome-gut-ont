# Copy to api/.env. uvicorn reads it with --env-file .env
PANBIOME_ENV=development
# Comma-separated origins allowed by CORS. Required when PANBIOME_ENV=production (never "*").
# In development, leaving it empty allows http://localhost:WEB_DEV_PORT and http://127.0.0.1:WEB_DEV_PORT.
ALLOWED_ORIGINS=
WEB_DEV_PORT=5173
# Outputs of the panbiome-gut-ont-batch stack
PANBIOME_BUCKET=panbiome-gut-ont-ACCOUNT_ID-ap-south-1
# Region of the stack. Set here because boto3 ignores AWS_REGION and the profile may default elsewhere.
PANBIOME_REGION=ap-south-1
PANBIOME_HEAD_QUEUE=panbiome-ondemand
PANBIOME_TASK_QUEUES=panbiome-default,panbiome-ondemand,panbiome-build
PANBIOME_LOG_GROUP=/aws/batch/job
# Local development uses your SSO login (aws sso login --profile programmable-bio)
AWS_PROFILE=programmable-bio
