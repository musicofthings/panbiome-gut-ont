// Database preset for main.nf runs on AWS Batch: the copies that infra/aws/fetch_dbs.nf and
// infra/aws/build_kraken2.nf put under s3://BUCKET/db. infra/aws/run.sh appends this file to the run's
// config after setting params.db_root, so a run only needs --fastq and --sample_sheet.
// Any --param on the command line still wins.
params {
    host_ref          = "${params.db_root}/host/chm13v2.0.map-ont.mmi"
    kraken2_db        = "${params.db_root}/k2_gtdb_r226_64GB"
    // The 64 GB build keeps about 9.6% of k-mers, which lowers every read's confidence score (docs/DATABASES.md)
    kraken2_confidence = 0.005
    sylph_db          = "${params.db_root}/sylph/gtdb-r226-c200-dbv2.syl2db"
    sylph_lineage_map = "${params.db_root}/sylph/gtdb_r226_map.tsv"
    checkm2_db        = "${params.db_root}/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
    amrfinder_db      = "${params.db_root}/amrfinder/latest"
    genomad_db        = "${params.db_root}/genomad/genomad_db"
    eggnog_db         = "${params.db_root}/eggnog"
}
