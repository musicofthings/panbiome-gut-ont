#!/usr/bin/env python3
"""fetch_url URL OUT: download URL to OUT, resuming with HTTP Range requests after dropped connections.
The core and Bracken images have python3 but no curl or wget."""
import http.client
import os
import sys
import time
import urllib.error
import urllib.request

ATTEMPTS = 50

url, out = sys.argv[1], sys.argv[2]
for attempt in range(1, ATTEMPTS + 1):
    done = os.path.getsize(out) if os.path.exists(out) else 0
    headers = {"Range": f"bytes={done}-"} if done else {}
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=120) as src:
            if done and src.status != 206:
                done = 0
            with open(out, "ab" if done else "wb") as dst:
                while chunk := src.read(1 << 24):
                    dst.write(chunk)
        break
    except urllib.error.HTTPError as e:
        if e.code == 416 and done:
            break
        if attempt == ATTEMPTS or e.code < 500:
            raise
        err = e
    except (OSError, http.client.HTTPException) as e:
        if attempt == ATTEMPTS:
            raise
        err = e
    print(f"fetch_url: attempt {attempt} stopped at {os.path.getsize(out)} bytes ({err!r}), resuming", file=sys.stderr)
    time.sleep(min(60, 5 * attempt))
