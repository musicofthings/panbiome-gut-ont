// panbiome-gut-ont: ONT shotgun / 16S gut microbiome workflow for EPI2ME

manifest {
    name            = 'musicofthings/panbiome-gut-ont'
    author          = 'Panbiome'
    homePage        = 'https://github.com/musicofthings/panbiome-gut-ont'
    description     = 'Oxford Nanopore gut microbiome workflow: QC, host depletion, species profiling, assembly, MAGs, AMR, function, diversity and reports.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.1'
}

params {
    help    = false
    version = false

    // ---- input ----
    fastq        = null          // directory of barcode folders, a folder of FASTQ/BAM, or one file
    sample_sheet = null          // CSV: barcode,alias,type[,group,subject_id,...]
    out_dir      = 'output'
    required_metadata = ''       // comma list of sample sheet columns that must be filled

    // ---- assay ----
    assay = 'shotgun'            // shotgun | 16s | both

    // ---- run metadata (washed flow cell, PGx first) ----
    pgx_barcodes = ''            // barcodes used by the earlier PGx library (rejected in the gut sheet)
    pgx_regions  = null          // BED of PGx target regions in host_ref coordinates (carryover check)
    pore_count   = 0             // available pores at load (first pore scan)
    run_hours    = 0

    // ---- read filtering ----
    min_len        = 500
    max_len        = 0           // 0 = no upper limit
    min_q          = 10
    adapters_fasta = null        // extra adapter/barcode sequences for the prevalence check

    // ---- host depletion ----
    host_ref              = null // minimap2 index (.mmi) or FASTA of the human reference (T2T-CHM13)
    skip_host_depletion   = false
    host_min_aligned_frac = 0.5

    // ---- species profiling ----
    kraken2_db               = null
    kraken2_confidence       = 0.05
    kraken2_memory_mapping   = false
    bracken_read_len         = 1000
    bracken_threshold        = 10
    sylph_db                 = null     // .syldb
    sylph_lineage_map        = null     // accession<TAB>GTDB lineage (see bin/make_sylph_lineage_map.py)
    sylph_args               = ''       // e.g. '--read-seq-id 90' (check `sylph profile --help`)
    emu_db                   = null
    taxa_rule                = 'both'   // both | either
    primary_method           = 'bracken'
    min_species_reads        = 50
    min_ani                  = 95
    min_cov                  = 0
    taxa_synonyms            = null
    watchlist                = "${projectDir}/assets/gut_watchlist.tsv"
    save_read_classification = false
    save_nonhost_reads       = false   // non-host reads only; human reads are never stored

    // ---- assembly, MAGs, annotation ----
    skip_assembly   = false
    skip_polish     = false
    flye_args       = ''
    medaka_model    = 'r1041_e82_400bps_sup_v5.0.0'
    skip_binning    = false
    semibin_env     = 'human_gut'
    checkm2_db      = null      // diamond database file (.dmnd)
    gtdbtk_db       = null
    amrfinder_db    = null
    amr_min_cov     = 90
    amr_min_id      = 90
    genomad_db      = null
    eggnog_db       = null
    functional_targets = "${projectDir}/assets/functional_targets.tsv"

    // ---- controls (scheduled control runs) ----
    mock_expected        = null  // TSV: taxon, expected_rel_abundance
    control_summary      = null  // control_summary.json from the latest control run
    control_max_age_days = 31
    mock_max_bray        = 0.30
    mock_max_unexpected  = 0.05

    // ---- QC thresholds (placeholders: fix during validation) ----
    target_gb      = 3.0
    min_gb         = 1.0
    qc_min_reads   = 100000
    qc_min_mean_q  = 10
    adapter_warn_pct = 5
    host_warn_pct  = 20
    balance_ratio  = 0.5

    // ---- report ----
    clinic_name = 'Panbiome'
    group_col   = 'group'

    // ---- compute ----
    threads    = 8
    big_memory = '32 GB'

    // ---- containers (override to pin or mirror) ----
    container_core     = 'ghcr.io/musicofthings/panbiome-gut-ont-core:0.1.0'
    container_kraken2  = 'quay.io/biocontainers/kraken2:2.17.2--pl5321h3be2455_0'
    container_bracken  = 'quay.io/biocontainers/bracken:3.1p1--hc52dbad_0'
    container_krona    = 'quay.io/biocontainers/krona:2.7.1--pl526_0'
    container_sylph    = 'quay.io/biocontainers/sylph:1.0.0--hb42e459_0'
    container_emu      = 'quay.io/biocontainers/emu:3.6.2--hdfd78af_0'
    container_flye     = 'quay.io/biocontainers/flye:2.9.6--py312h734f728_1'
    container_medaka   = 'quay.io/biocontainers/medaka:2.2.2--py312h3050eb1_0'
    container_semibin  = 'quay.io/biocontainers/semibin:2.6.0--pyhdfd78af_0'
    container_checkm2  = 'quay.io/biocontainers/checkm2:1.1.0--pyhdfd78af_2'
    container_gtdbtk   = 'quay.io/biocontainers/gtdbtk:2.8.0--pyhdfd78af_0'
    container_amrfinder = 'quay.io/biocontainers/ncbi-amrfinderplus:4.2.7--hf69ffd2_0'
    container_genomad  = 'quay.io/biocontainers/genomad:1.13.0--pyhdfd78af_0'
    container_pyrodigal = 'quay.io/biocontainers/pyrodigal:3.7.1--py312h247cb63_1'
    container_eggnog   = 'quay.io/biocontainers/eggnog-mapper:2.1.15--pyhdfd78af_0'
}

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: small  { cpus = 2;               memory = { 4.GB * task.attempt } }
    withLabel: medium { cpus = { params.threads }; memory = { 16.GB * task.attempt } }
    withLabel: big    { cpus = { params.threads }; memory = { (params.big_memory as nextflow.util.MemoryUnit) * task.attempt } }
}

profiles {
    // EPI2ME runs workflows with docker by default
    standard {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor = 'local'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.executor = 'local'
    }
    local {
        process.executor = 'local'
    }
    // tiny resources for -stub-run and CI
    test {
        params.threads    = 2
        params.big_memory = '2 GB'
        process {
            withLabel: small  { cpus = 1; memory = 1.GB }
            withLabel: medium { cpus = 1; memory = 1.GB }
            withLabel: big    { cpus = 1; memory = 1.GB }
        }
    }
}

timeline { enabled = true; overwrite = true; file = "${params.out_dir}/execution/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.out_dir}/execution/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.out_dir}/execution/trace.txt" }
